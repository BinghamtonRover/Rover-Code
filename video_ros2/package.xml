<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>video_ros2</name>
  <version>1.0.0</version>
  <description>ROS2 video program in C++ for BURT rover camera streaming.</description>
  <maintainer email="rovewr@todo.todo">rovewr</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>subsystems_ros2</depend>
  <depend>protobuf</depend>
  <depend>libopencv-dev</depend>
  <!-- librealsense2-dev is optional; RealSense support is compiled out when absent. -->
  <depend>librealsense2-dev</depend>
  <depend>libjpeg-turbo8-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>gtest_vendor</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
